# Wiring for the NAS deployment: copy to .env.nas (gitignored) at the repo root and check the values.
# scripts/ps1/deploy-nas.ps1 and `docker --context synology compose --env-file .env.nas ...` read it
# on this PC. Paths are absolute paths on the NAS. No secrets here: deploy-nas.ps1 writes those
# straight to CORTEX_SECRETS_PATH on the NAS.

# No version here: deploy-nas.ps1 builds and tags the image from the VERSION file.

# NAS folders (created by deploy-nas.ps1 when missing).
CORTEX_DATA_PATH=/volume1/docker/cortex/data
CORTEX_CONFIG_PATH=/volume1/docker/cortex/config
CORTEX_LOGS_PATH=/volume1/docker/cortex/logs
CORTEX_SECRETS_PATH=/volume1/docker/cortex/secrets

# The user and group Cortex runs as; deploy-nas.ps1 gives the folders above to them.
PUID=1000
PGID=1000

# Port published on the NAS.
CORTEX_PORT=8765

# Timezone for SYNAPSE and ENGRAM dates and log timestamps.
TZ=America/Chicago
