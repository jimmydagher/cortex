# Wiring for docker-compose.yml on the NAS: copy to .env in the same folder and fill in.
# No secrets here: the admin password and session key are files in CORTEX_SECRETS_PATH.

# The released version to run (a tag CI pushed to ghcr.io/jimmydagher/cortex).
CORTEX_VERSION=0.1.0

# Host folders mounted into the container.
CORTEX_DATA_PATH=/volume1/docker/cortex/data
CORTEX_CONFIG_PATH=/volume1/docker/cortex/config
CORTEX_LOGS_PATH=/volume1/docker/cortex/logs
CORTEX_SECRETS_PATH=/volume1/docker/cortex/secrets

# NAS user and group that own those folders, so files Cortex writes keep your ownership.
PUID=1000
PGID=1000

# Port published on the NAS.
CORTEX_PORT=8765

# Timezone for SYNAPSE and ENGRAM dates and log timestamps.
TZ=UTC
